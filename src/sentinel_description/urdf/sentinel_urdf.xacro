<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org" name="sentinel">

  <!-- Properties (Dimensions in meters) -->
  <xacro:property name="chassis_length" value="0.45"/>
  <xacro:property name="chassis_width" value="0.32"/>
  <xacro:property name="chassis_height" value="0.14"/>
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_offset_y" value="0.18"/>
  <xacro:property name="wheel_offset_x" value="-0.08"/>

  <!-- Materials for RViz -->
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="safety_yellow"><color rgba="0.95 0.75 0.05 1.0"/></material>
  <material name="sensor_blue"><color rgba="0.1 0.4 0.9 1.0"/></material>
  <material name="thermal_red"><color rgba="0.85 0.15 0.15 1.0"/></material>

  <!-- 1. Ground Reference Frame -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- 2. Main Chassis -->
  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="safety_yellow"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.15" iyz="0" izz="0.20"/>
    </inertial>
  </link>

  <!-- 3. Motorized Drive Wheel Macro -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0016"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_offset_x} ${reflect * wheel_offset_y} ${-chassis_height/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- 4. Front Caster Wheel (Stability) -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${wheel_radius/2}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${wheel_radius/2}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="0.15 0 ${-chassis_height/2 - wheel_radius/2}" rpy="0 0 0"/>
  </joint>

  <!-- 5. 2D LiDAR Sensor (For Substation SLAM & Navigation) -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="sensor_blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.10 0 ${chassis_height/2 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- 6. Thermal / RGB Inspection Camera -->
  <link name="camera_frame">
    <visual>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
      <material name="thermal_red"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.08 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_frame"/>
    <origin xyz="${chassis_length/2 + 0.015} 0 0.02" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find sentinel_description)/urdf/sentinel_gazebo.xacro"/>

</robot>